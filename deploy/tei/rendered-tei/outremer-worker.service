# The packaged nightly (#134): the worker IS deploy/tei/nightly.sh, run by
# systemd instead of cron. One implementation of the order that makes the
# nightly safe — pull, preflight, pipeline under --airgap, PROVENANCE GATE,
# evaluation history, status.json, mirror into the served state, publish —
# instead of a second, gate-less copy (the run_pipeline.py-only worker this
# replaces would have published nothing gated, #134).
#
# It runs as the account that owns the work checkout and its GitHub push
# credentials (option 1 in #134: publish from a working checkout, never from
# an immutable release). Output is appended to the same nightly.log the cron
# wrote, so deploy/tei/healthcheck.sh keeps reading it unchanged.
[Unit]
Description=Outremer nightly: pull, preflight, pipeline, provenance gate, status, mirror, publish
Documentation=https://github.com/thodel/outremer/blob/main/deploy/tei/README.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/dh/outremer/work/deploy/tei/nightly.sh

[Service]
Type=oneshot
User=dh
Group=dh
# writes the served mirror, which belongs to the runtime account's group
SupplementaryGroups=outremer
WorkingDirectory=/home/dh/outremer/work
Environment=OUTREMER_WORK=/home/dh/outremer/work
Environment=OUTREMER_PUBLIC_SITE=/var/lib/outremer/state/site
ExecStart=/bin/bash /home/dh/outremer/work/deploy/tei/nightly.sh
StandardOutput=append:/home/dh/outremer/logs/nightly.log
StandardError=append:/home/dh/outremer/logs/nightly.log
TimeoutStartSec=6h
UMask=0002
TasksMax=512
# tei has 3.8 GB: throttle above 2 GB, kill only near the whole box.
MemoryHigh=2G
MemoryMax=3G

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
# The work checkout, its venv, logs, pip cache and ssh known_hosts live in the
# worker's home; the mirror is the only path outside it the nightly writes.
ReadWritePaths=/home/dh /var/lib/outremer/state/site
